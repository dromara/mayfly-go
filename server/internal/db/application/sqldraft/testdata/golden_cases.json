    "chooser": [
      "t_db_metric_sample",
      "t_db_instance"
    ],
    "model": [
      "{\"statements\":[{\"sql\":\"SELECT i.id, i.name, AVG(m.value) AS avg_query_time FROM `t_db_instance` i JOIN `t_db_metric_sample` m ON m.instance_id = i.id WHERE i.is_deleted = 0 AND m.metric = 'query_time' AND m.sample_time >= DATE_SUB(NOW(), INTERVAL 30 DAY) GROUP BY i.id, i.name\"}]}"
