        ]
      },
      {
        "name": "t_db_instance",
        "columns": [
          {
            "name": "id",
            "type": "bigint",
            "pk": true
          },
          {
            "name": "name",
            "type": "varchar(255)"
          },
          {
            "name": "is_deleted",
            "type": "tinyint"
          }
        ]
      }
