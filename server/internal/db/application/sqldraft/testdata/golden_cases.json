[
  {
    "id": "instance_db_count",
    "intent": "draft",
    "prompt": "统计每个数据库实例下有多少个数据库资源",
    "tables": [
      {
        "name": "t_db_instance",
        "comment": "数据库实例",
        "columns": [
          {
            "name": "id",
            "type": "bigint",
            "pk": true
          },
          {
            "name": "code",
            "type": "varchar(32)"
          },
          {
            "name": "name",
            "type": "varchar(255)"
          },
          {
            "name": "is_deleted",
            "type": "tinyint"
          }
        ]
      },
      {
        "name": "t_db",
        "comment": "数据库资源",
        "columns": [
          {
            "name": "id",
            "type": "bigint",
            "pk": true
          },
          {
            "name": "instance_id",
            "type": "bigint"
          },
          {
            "name": "is_deleted",
            "type": "tinyint"
          }
        ]
      }
    ],
    "chooser": [
      "t_db_instance",
      "t_db"
    ],
    "model": [
      "{\"statements\":[{\"sql\":\"SELECT `i`.`id` AS `instance_id`, `i`.`name` AS `instance_name`, COUNT(`d`.`id`) AS `db_count` FROM `t_db_instance` AS `i` LEFT JOIN `t_db` AS `d` ON `d`.`instance_id` = `i`.`id` AND `d`.`is_deleted` = 0 WHERE `i`.`is_deleted` = 0 GROUP BY `i`.`id`, `i`.`name` ORDER BY `db_count` DESC\",\"notes\":\"按实例统计库数量\"}]}"
    ],
    "expect": {
      "pickedContains": [
        "t_db_instance",
        "t_db"
      ],
      "verification": "verified",
      "findingCodes": []
    }
  },
