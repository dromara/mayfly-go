### ddl-create
CREATE TABLE t (id INT, name VARCHAR(20))
  = *sqlstmt.DdlStmt
  text="CREATE TABLE t (id INT, name VARCHAR(20))"
  ddlKind="CREATE"

### ddl-alter
ALTER TABLE t ADD COLUMN age INT
  = *sqlstmt.DdlStmt
  text="ALTER TABLE t ADD COLUMN age INT"
  ddlKind="ALTER"

### ddl-drop
DROP TABLE IF EXISTS t
  = *sqlstmt.DdlStmt
  text="DROP TABLE IF EXISTS t"
  ddlKind="DROP"

### ddl-truncate
TRUNCATE TABLE t
  = *sqlstmt.DdlStmt
  text="TRUNCATE TABLE t"
  ddlKind="DDL"

### cte-with
WITH c AS (SELECT id FROM t) SELECT id FROM c
  = *sqlstmt.WithStmt
  text="WITH c AS (SELECT id FROM t) SELECT id FROM c"

### stmt-show
SHOW TABLES
  = *sqlstmt.OtherStmt
  text="SHOW TABLES"

### stmt-unknown
VACUUM ANALYZE t
  = *sqlstmt.OtherStmt
  text="VACUUM ANALYZE t"

