# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

*.lock
*.sum

# Dependencies and build caches. A pattern without a leading slash matches at any
# depth (*/node_modules/ used to miss the copy at the repository root)
node_modules/
**/vendor/
.idea
.vscode
.qoder
out

server/docs/docker-compose
server/config.yml
server/ip2region.xdb
mayfly-go.log

mayfly-go-linux-amd64/

# local build binaries
server/mayfly-go
server/mayfly-server
cli/cli
build/

# Local SQLite database created by running the server from the workspace: runtime
# output holding real data, must never be committed
server/*.db

# local tool artifacts
.impeccable/

.DS_Store
__debug_*